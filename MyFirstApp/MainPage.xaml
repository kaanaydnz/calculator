<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyFirstApp.MainPage"
             BackgroundColor="#000000">

    <Grid Padding="20"
          RowDefinitions="*,Auto">

        <Grid Grid.Row="0"
              RowDefinitions="*,5*">

            <Grid Grid.Row="0"
                  RowDefinitions="Auto,*"
                  Padding="5,10"
                  RowSpacing="5">

                <Label x:Name="OperationHistory"
                       Grid.Row="0"
                       Text=""
                       TextColor="White"
                       FontSize="20"
                       HorizontalTextAlignment="End"
                       VerticalTextAlignment="Center"
                       HeightRequest="35"
                       LineBreakMode="NoWrap"/>

                <Label x:Name="Screen"
                       Grid.Row="1"
                       Text="0"
                       TextColor="White"
                       FontSize="64"
                       HorizontalTextAlignment="End"
                       VerticalTextAlignment="Center"
                       VerticalOptions="End"
                       LineBreakMode="NoWrap"/>

            </Grid>


            <Grid Grid.Row="1"
                  RowDefinitions="*,*,*,*,*"
                  ColumnDefinitions="*,*,*,*"
                  Padding="10"
                  ColumnSpacing="5"
                  RowSpacing="5">

                <!-- 1. Satır -->
                <Button Text="C"
                        Grid.Row="0"
                        Grid.Column="0"
                        Clicked="ClearClicked"/>

                <Button Text="⌫"
                        Grid.Row="0"
                        Grid.Column="1"
                        Clicked="BackspaceClicked"/>

                <Button Text="%"
                        Grid.Row="0"
                        Grid.Column="2"
                        Clicked="PercentClicked"/>

                <Button Text="/"
                        Grid.Row="0"
                        Grid.Column="3"
                        Clicked="DivideOperator_OnClicked"/>

                <!-- 2. Satır -->
                <Button Text="7"
                        CommandParameter="7"
                        Grid.Row="1"
                        Grid.Column="0"
                        Clicked="DigitClicked"/>

                <Button Text="8"
                        CommandParameter="8"
                        Grid.Row="1"
                        Grid.Column="1"
                        Clicked="DigitClicked"/>

                <Button Text="9"
                        CommandParameter="9"
                        Grid.Row="1"
                        Grid.Column="2"
                        Clicked="DigitClicked"/>

                <Button Text="*"
                        Grid.Row="1"
                        Grid.Column="3"
                        Clicked="MultiplyOperator_OnClicked"/>

                <!-- 3. Satır -->
                <Button Text="4"
                        CommandParameter="4"
                        Grid.Row="2"
                        Grid.Column="0"
                        Clicked="DigitClicked"/>

                <Button Text="5"
                        CommandParameter="5"
                        Grid.Row="2"
                        Grid.Column="1"
                        Clicked="DigitClicked"/>

                <Button Text="6"
                        CommandParameter="6"
                        Grid.Row="2"
                        Grid.Column="2"
                        Clicked="DigitClicked"/>

                <Button Text="-"
                        Grid.Row="2"
                        Grid.Column="3"
                        Clicked="MinusOperator_OnClicked"/>

                <!-- 4. Satır -->
                <Button Text="1"
                        CommandParameter="1"
                        Grid.Row="3"
                        Grid.Column="0"
                        Clicked="DigitClicked"/>

                <Button Text="2"
                        CommandParameter="2"
                        Grid.Row="3"
                        Grid.Column="1"
                        Clicked="DigitClicked"/>

                <Button Text="3"
                        CommandParameter="3"
                        Grid.Row="3"
                        Grid.Column="2"
                        Clicked="DigitClicked"/>

                <Button Text="+"
                        Grid.Row="3"
                        Grid.Column="3"
                        Clicked="SumOperator_OnClicked"/>

                <!-- 5. Satır -->
                <Button Text="0"
                        CommandParameter="0"
                        Grid.Row="4"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Clicked="DigitClicked"/>

                <Button Text="."
                        Grid.Row="4"
                        Grid.Column="2"
                        Clicked="DecimalClicked"/>

                <Button Text="="
                        Grid.Row="4"
                        Grid.Column="3"
                        Clicked="EqualOperator_OnClicked"/>

            </Grid>
        </Grid>

    </Grid>
</ContentPage>
